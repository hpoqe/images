{
  "name": "photo-gallery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "process": "tsx scripts/build-photos.ts",
    "typecheck": "vue-tsc --noEmit",
    "classify": "tsx scripts/auto-classify.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "lenis": "^1.3.26",
    "pinia": "^4.1.0",
    "sharp": "^0.35.5",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.0"
  }
}
